CLICKUP_API_TOKEN=
CLICKUP_LIST_ID_WHATSAPP_LEADS=

# Shared secret this function checks on incoming requests (Authorization: Bearer <token>).
# Set this to whatever value you configure as the auth header when registering the
# custom connector in Meta Business Agent Platform.
META_CONNECTOR_SHARED_SECRET=

# Only needed if Meta requires the standard webhook verification handshake
# (GET request with hub.mode/hub.verify_token/hub.challenge) for this connector.
META_WEBHOOK_VERIFY_TOKEN=
