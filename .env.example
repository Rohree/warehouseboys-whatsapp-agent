CLICKUP_API_TOKEN=
CLICKUP_LIST_ID_WHATSAPP_LEADS=

# Cloud API phone number ID the webhook sends/receives messages through.
WHATSAPP_PHONE_NUMBER_ID=

# System user token (whatsapp_business_messaging scope) used to call the Graph API
# /messages endpoint from lib/whatsapp.js.
META_SYSTEM_USER_ACCESS_TOKEN=

# Value Meta echoes back during the webhook verify handshake
# (GET request with hub.mode/hub.verify_token/hub.challenge).
META_WEBHOOK_VERIFY_TOKEN=

# Only used by create-lead.js, the parked Meta Business Agent tool endpoint (see README).
# Shared secret checked on incoming requests (Authorization: Bearer <token>).
META_CONNECTOR_SHARED_SECRET=

# When set, only these numbers (comma-separated, E.164 without +) get a response from the
# webhook - everyone else is silently ignored. Unset/empty to go live for everyone.
TEST_MODE_ALLOWED_NUMBERS=
